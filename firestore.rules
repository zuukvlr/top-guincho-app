rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Somente os e-mails da equipe (cadastrados em Authentication) acessam os dados.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['makurbanooficial@gmail.com'];
    }
  }
}
